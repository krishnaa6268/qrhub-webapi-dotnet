# ==============================================================================
# QRHub Environment Template (.env.example)
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=qrhub_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONTAINER_NAME=qrhub-postgres

# Database Connection String
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=qrhub_db;Username=postgres;Password=postgres;

# JWT Authentication Settings (Minimum 32 characters for HMAC-SHA256)
JwtSettings__Secret=your_at_least_32_characters_long_jwt_secret_key_here!
JwtSettings__Issuer=QRHubApi
JwtSettings__Audience=QRHubClient
JwtSettings__ExpiryMinutes=1440

# Aliases for Docker / External tools
JWT_SECRET=your_at_least_32_characters_long_jwt_secret_key_here!
JWT_ISSUER=QRHubApi
JWT_AUDIENCE=QRHubClient
JWT_EXPIRY_MINUTES=1440

# API Server Configuration
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5143
API_CONTAINER_NAME=qrhub-api
